<?xml version="1.0" encoding="UTF-8"?>

<service-eca xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/service-eca.xsd">
    <!-- 部门添加成员时触发 -->
    <eca service="banfftech.createPartyRelationship" event="return">
        <condition field-name="roleTypeIdTo" operator="equals" value="ORD_EMPLOYEE"/>
        <action service="banfftech.updateMemberNumber" mode="sync"/>
    </eca>
    <eca service="banfftech.createPartyAndContact" event="return">
        <action service="banfftech.createUserLoginAndPermission" mode="sync"/>
    </eca>
</service-eca>
