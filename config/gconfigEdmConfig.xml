<ofbiz-edm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://dev.odatalab.com/dtds/edmconfig.xsd"
           ImportGlobal="false">
    <EntityType Name="DBEntity" AutoProperties="true" EntitySetName="DBEntities">
        <NavigationProperty Name="DBField"/>
        <NavigationProperty Name="DBRelation"/>
    </EntityType>
    <EntityType Name="DBField" AutoProperties="true" EntitySetName="DBFields">
        <NavigationProperty Name="DBEntity"/>
    </EntityType>
    <EntityType Name="DBRelation" AutoProperties="true" EntitySetName="DBRelations">
        <NavigationProperty Name="DBEntity"/>
    </EntityType>

    <Action Name="CreateEntityType" IsBound="false" OfbizService="com.banfftech.event.EdmServiceEvent.createEntityType">
        <Parameter Name="data" Type="String" IsCollection="false" Nullable="false"/>
    </Action>

    <EntityContainer>
        <ActionImport Action="CreateEntityType" Name="CreateEntityType"/>
    </EntityContainer>

</ofbiz-edm>
