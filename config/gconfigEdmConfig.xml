<ofbiz-edm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://dev.odatalab.com/dtds/edmconfig.xsd"
           ImportGlobal="false">

    <!--DB-->
    <EntityType Name="DBEntity" AutoProperties="true" EntitySetName="DBEntities">
        <NavigationProperty Name="DBField"/>
        <NavigationProperty Name="DBRelation"/>
    </EntityType>
    <EntityType Name="DBField" AutoProperties="true" EntitySetName="DBFields">
        <NavigationProperty Name="DBEntity"/>
    </EntityType>
    <EntityType Name="DBRelation" AutoProperties="true" EntitySetName="DBRelations">
        <NavigationProperty Name="DBEntity"/>
    </EntityType>

    <!--Edm-->
    <EntityType Name="EdmService" AutoProperties="false" EntitySetName="EdmServices">
        <Property Name="edmServiceId"/>
        <Property Name="serviceName"/>
        <Property Name="description"/>
        <NavigationProperty Name="EdmServiceContent"/>
    </EntityType>
    <EntityType Name="EdmEntityType" AutoProperties="true" EntitySetName="EdmEntityTypes">
        <NavigationProperty Name="EdmProperty"/>
        <NavigationProperty Name="EdmNavigationProperty"/>
    </EntityType>
    <EntityType Name="EdmProperty" AutoProperties="true" EntitySetName="EdmProperties"/>
    <EntityType Name="EdmNavigationProperty" AutoProperties="true" EntitySetName="EdmNavigationProperties"/>
    <EntityType Name="EdmServiceContent" AutoProperties="true" EntitySetName="EdmServiceContents"/>

    <Action Name="CreateEntityType" IsBound="false" OfbizService="com.banfftech.event.EdmServiceEvent.createEntityType">
        <Parameter Name="edmServiceId" Type="String" IsCollection="false" Nullable="false"/>
        <Parameter Name="data" Type="String" IsCollection="false" Nullable="false"/>
    </Action>

    <EntityContainer>
        <ActionImport Action="CreateEntityType" Name="CreateEntityType"/>
    </EntityContainer>

</ofbiz-edm>
