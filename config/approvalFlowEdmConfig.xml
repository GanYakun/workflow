<ofbiz-edm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://dev.odatalab.com/dtds/edmconfig.xsd"
           ImportGlobal="false">
    <!-- 人员数据 -->
    <ImportEdm Path="component://bfcommon/config/orgStructureManageEdmConfig.xml"/>

    <!-- 主流程对象 -->
    <EntityType Name="MainProcess" EntitySetName="MainProcess" AutoProperties="true"
                Handler="component://gongsconfig/groovyScripts/mainProcess/generateFields.groovy">
        <!-- 实例数量 -->
        <Property Name="totalQuantity" Type="Edm.Decimal"/>
        <Property Name="progressingQuantity" Type="Edm.Decimal"/>
        <Property Name="completedQuantity" Type="Edm.Decimal"/>

        <!-- 流程设计发布 -->
        <Action Name="SaveProcess" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.saveProcess">
            <Parameter Name="mainProcess" Type="MainProcess" Nullable="false" IsCollection="false"/>
            <Parameter Name="nodeData" Type="Edm.String" Nullable="false" IsCollection="false"/>
            <Parameter Name="enable" Type="Boolean" Nullable="true" IsCollection="false"/>
        </Action>
        <!-- 发布(启用) -->
        <Action Name="PublishFlow" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.publishFlow">
            <Parameter Name="mainProcess" Type="MainProcess" Nullable="false" IsCollection="false"/>
        </Action>
        <!-- 停用 -->
        <Action Name="StopFlow" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.stopFlow">
            <Parameter Name="mainProcess" Type="MainProcess" Nullable="false" IsCollection="false"/>
        </Action>
        <NavigationProperty Name="WorkEffort"/>
        <NavigationProperty Name="DBEntity" Type="ProcessEntity"/>
        <NavigationProperty Name="RangeEnumeration"/>
        <NavigationProperty Name="StatusItem"/>
    </EntityType>

    <!-- 业务对象 -->
    <EntityType Name="ProcessEntity" OfbizEntity="DBEntity" AutoProperties="true" EntitySetName="ProcessEntities"
                Handler="component://gongsconfig/groovyScripts/processEntity/generateFields.groovy">
        <SelectionFields PropertyPath="dbEntityId,dbEntityName,description"/>
        <Property Name="isOpen" Type="Boolean"/>
        <!-- 是否定义有效流程 -->
        <Property Name="hasActiveFlow" Type="Boolean" Label="${hasActiveFlow}"/>
        <!-- 可配置字段数量 -->
        <Property Name="configFieldTotal" Type="Edm.Decimal" Label="${configFieldTotal}"/>
        <HeaderInfo>
            <Title Path="dbEntityName"/>
            <Description Path="description"/>
        </HeaderInfo>
        <FieldGroup Qualifier="BasicInfo" Label="BasicInfo">
            <DataField Values="dbEntityTypeId,isOpen,hasActiveFlow" Importance="High"/>
        </FieldGroup>
        <!-- 初始化字段类型 -->
        <Action Name="InitFieldType" IsBound="true" OfbizService="com.banfftech.event.ApprovalObjectEvent.initFieldType">
            <Parameter Name="dbEntity" Type="ProcessEntity" Nullable="false" IsCollection="false"/>
        </Action>
        <NavigationProperty Name="DBField"/>
        <NavigationProperty Name="OpenDBField" Type="DBField" IsCollection="true" Relations="DBField(isOpen=Y)"/>
    </EntityType>

    <!-- 业务对象字段 -->
    <EntityType Name="DBField" AutoProperties="true" EntitySetName="DBFields"
                SearchOption="dbFieldName,description">
        <Property Name="asCondition" Type="Boolean"/>
        <Property Name="isOpen" Type="Boolean"/>
        <Property Name="dbFieldTypeId">
            <Text Path="DBFieldType/description" TextArrangement="TextOnly"/>
            <ValueList CollectionPath="DBFieldTypes" WithFixedValues="true" ParameterDisplayOnly="description">
                <ParameterInOut LocalDataProperty="dbFieldTypeId" ValueListProperty="dbFieldTypeId"/>
            </ValueList>
        </Property>
        <HeaderInfo>
            <Title Path="dbFieldName"/>
            <Description Path="description"/>
        </HeaderInfo>
        <LineItem Qualifier="EditLineItem">
            <DataField Values="dbFieldName,dbFieldTypeId,asCondition,valueTypeId,description,isOpen"/>
        </LineItem>
        <LineItem Qualifier="OpenLineItem">
            <DataField Values="dbFieldName,dbFieldTypeId,asCondition,description"/>
        </LineItem>
        <NavigationProperty Name="DBFieldType"/>
        <NavigationProperty Name="DBFieldLabel"/>
        <Action Name="AddLabel" IsBound="true" OfbizService="com.banfftech.event.ApprovalObjectEvent.addLabel">
            <Parameter Name="dbField" Type="DBField" Nullable="false" IsCollection="false"/>
            <Parameter Name="language" Type="String" Nullable="false" IsCollection="false">
                <ValueList CollectionPath="LanguageEnumerations" WithFixedValues="true" ParameterDisplayOnly="description" Label="Select Language">
                    <ParameterInOut ValueListProperty="enumId" LocalDataProperty="language"/>
                </ValueList>
            </Parameter>
            <Parameter Name="value" Type="String" Nullable="false" IsCollection="false"/>
        </Action>
    </EntityType>

    <EntityType Name="DBFieldLabel" AutoProperties="true" EntitySetName="DBFieldLabels">
        <LineItem>
            <DataField Values="language,value"/>
        </LineItem>
    </EntityType>
    
    <EntityType Name="DBFieldType" AutoProperties="true" EntitySetName="DBFieldTypes">
        <Property Name="dbFieldTypeId">
            <Text Path="description" TextArrangement="TextOnly"/>
        </Property>
    </EntityType>
    
    <EntityType Name="WorkEffort" EntitySetName="WorkEfforts" Properties="workEffortId,workEffortName,noteId,currentStatusId,createdByUserLogin,createdDate">
        <RelAlias Name="partyName" Relations="UserLogin/Party" Properties="partyName"/>
        <NavigationProperty Name="NoteData"/>
        <NavigationProperty Name="ChildWorkEffort"/>
        <NavigationProperty Name="NodeWorkEffort"/>
        <NavigationProperty Name="UserLogin"/>
        <NavigationProperty Name="CurrentStatusItem"/>
    </EntityType>
    <EntityType Name="NoteData" EntitySetName="NoteDatas" AutoProperties="true"/>

    <!-- 入库请求单的demo -->
    <EntityType Name="InCustRequest" OfbizEntity="CustRequest" EntitySetName="InCustRequests" AutoProperties="true">
        <Action Name="SubmitApproval" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.submitApproval">
            <Parameter Name="inCustRequest" Type="InCustRequest" Nullable="false" IsCollection="false"/>
        </Action>
    </EntityType>
    <!-- 入库请求单的demo -->
    <EntityType Name="PartyAndContact" OfbizEntity="PartyAndContact" EntitySetName="PartyAndContacts" AutoProperties="true">
        <Action Name="SubmitApproval" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.submitApproval">
            <Parameter Name="partyAndContact" Type="PartyAndContact" Nullable="false" IsCollection="false"/>
            <Parameter Name="type" Type="String" Nullable="false" IsCollection="false"/>
        </Action>
    </EntityType>

    <EntityType Name="StatusItem" EntitySetName="StatusItems" AutoProperties="true"/>
    <EntityType Name="RangeEnumeration" OfbizEntity="Enumeration" EntitySetName="RangeEnumerations" AutoProperties="true" EntityCondition="enumTypeId=PROCESS_RANGE"/>
    <EntityType Name="LanguageEnumeration" OfbizEntity="Enumeration" EntitySetName="LanguageEnumerations" AutoProperties="true" EntityCondition="enumTypeId=LANGUAGE_ENUM"/>
    <EntityType Name="Enumeration" EntitySetName="Enumerations" AutoProperties="true"/>


    <ComplexType Name="ValueItem">
        <Property Name="label" Type="String"/>
        <Property Name="value" Type="String"/>
    </ComplexType>
    <!-- 获取类型字段可选值列表 -->
    <Function Name="GetTypeData" OfbizService="com.banfftech.event.ApprovalEvent.getTypeData" IsBound="false">
        <Parameter Name="typeFieldName" Type="String" Nullable="false" IsCollection="false"/>
        <ReturnType Type="ValueItem" IsCollection="true"/>
    </Function>
    <EntityContainer>
        <FunctionImport Function="GetTypeData" Name="GetTypeData"/>
    </EntityContainer>


</ofbiz-edm>
