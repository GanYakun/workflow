<ofbiz-edm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://dev.odatalab.com/dtds/edmconfig.xsd" ImportGlobal="false">
    <ComplexType Name="ApproverData">
        <Property Name="nodeId" Type="Edm.Decimal"/>
        <Property Name="nodeName" Type="String"/>
        <Property Name="selectIdList" Type="String" IsCollection="true"/>
    </ComplexType>
    <!--=====================================     主对象EntityType definition     =====================================-->
    <!--请假审批-->
    <EntityType Name="LeaveApproval" OfbizEntity="EmplLeave" EntitySetName="LeaveApprovals" AutoProperties="true"
                EntityCondition="partyId=${userLogin.partyId}">
        <SelectionFields PropertyPath="leaveTypeId,emplLeaveReasonTypeId,fromDate,thruDate"/>
        <Property Name="emplLeaveId" Computed="true"/>
        <Property Name="leaveTypeId">
            <Text Path="LeaveType/description" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="partyId" Required="true" FieldControl="Mandatory"/>
        <Property Name="fromDate" Required="true" FieldControl="Mandatory"/>
        <Property Name="thruDate" Required="true" FieldControl="Mandatory"/>
        <Property Name="emplLeaveReasonTypeId" Required="true" FieldControl="Mandatory">
            <Text Path="LeaveReasonType/description" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="leaveStatus" DefaultValue="APPROVAL_CREATED">
            <Text Path="LeaveStatus/description" TextArrangement="TextOnly"/>
        </Property>
        <Function Name="GetApproverData" OfbizService="com.banfftech.event.ApprovalEvent.getApproverData" IsBound="true">
            <Parameter Name="leaveApproval" Type="LeaveApproval" Nullable="false" IsCollection="false"/>
            <ReturnType Type="ApproverData" IsCollection="true"/>
        </Function>
        <Action Name="SubmitApproval" IsBound="true" OfbizService="com.banfftech.event.ApprovalEvent.submitApproval" >
            <Parameter Name="leaveApproval" Type="LeaveApproval" Nullable="false" IsCollection="false"/>
            <Parameter Name="approverData" Type="String" Nullable="true" IsCollection="false"/>
        </Action>
        <LineItem>
            <DataField Values="partyId,leaveTypeId,emplLeaveReasonTypeId,fromDate,thruDate,leaveStatus" Importance="High"/>
            <DataFieldForAction Label="提交审批" Action="SubmitApproval" InvocationGrouping="Isolated"
                                Criticality="Positive" Inline="true" Importance="High" />
        </LineItem>
        <NavigationProperty Name="LeaveType" Relations="EmplLeaveType" Type="LeaveType"
                            IsCollection="false"/>
        <NavigationProperty Name="LeaveReasonType" Relations="EmplLeaveReasonType" Type="LeaveReasonType"
                            IsCollection="false"/>
        <NavigationProperty Name="LeaveStatus" Relations="StatusItem" Type="LeaveStatus"
                            IsCollection="false"/>
    </EntityType>

    <!--请假类型-->
    <EntityType Name="LeaveType" OfbizEntity="EmplLeaveType" EntitySetName="LeaveTypes" AutoProperties="true">
        <ValueList  CollectionPath="LeaveTypes" WithFixedValues="true" />
        <Property Name="leaveTypeId">
            <Text Path="description" TextArrangement="TextOnly"/>
        </Property>
    </EntityType>

    <!--请假原因-->
    <EntityType Name="LeaveReasonType" OfbizEntity="EmplLeaveReasonType" EntitySetName="LeaveReasonTypes"
                AutoProperties="true">
        <ValueList  CollectionPath="LeaveReasonTypes" WithFixedValues="true" />
        <Property Name="emplLeaveReasonTypeId">
            <Text Path="description" TextArrangement="TextOnly"/>
        </Property>
    </EntityType>

    <!--请假状态-->
    <EntityType Name="LeaveStatus" OfbizEntity="StatusItem" EntitySetName="LeaveStatusItems"
                EntityCondition="statusTypeId=LEAVE_STATUS" AutoProperties="true">
    </EntityType>
    <!--=====================================     子对象EntityType definition     =====================================-->
    <!--=====================================    Action Definition End   =====================================-->
</ofbiz-edm>
