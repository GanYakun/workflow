<!--            <Text Path="fixedAssetName" TextArrangement="TextOnly"/>-->
<!--        </Property>-->
<!--    </EntityType>-->

    <!--成员-->
    <EntityType Name="Member" OfbizEntity="PartyAndContact" EntitySetName="Members"
                EntityCondition="partyTypeId=PERSON and PartyRole/roleTypeId=ORD_EMPLOYEE"
                AutoProperties="true">
        <RelAlias Name="Person" Relations="Person"/>
        <Property Name="gender" RelAlias="Person" Field="gender" FieldControl="Mandatory" Required="true">
            <Text Path="GenderEnumeration/description" TextArrangement="TextOnly"/>
        </Property>
        <Property Name="birthDate" RelAlias="Person" Field="birthDate" FieldControl="Mandatory" Required="true"/>
        <Property Name="nickname" RelAlias="Person" Field="nickname" FieldControl="Mandatory" Required="true"/>
        <Property Name="partyTypeId" DefaultValue="PERSON"/>
        <Property Name="isManager" Type="Boolean"/>
        <Property Name="isNotManager" Type="Boolean"/>
        <Property Name="partyId" Immutable="true">
            <Text Path="partyName" TextArrangement="TextOnly"/>
        </Property>
        <NavigationProperty Name="Department" Type="Department"
                            Relations="ToPartyRelationship(roleTypeIdTo=ORD_EMPLOYEE)/FromPartyAndPartyGroup"
                            IsCollection="false"/>
    </EntityType>

    <!--部门-->
    <EntityType Name="Department" OfbizEntity="PartyAndPartyGroup" EntitySetName="Departments"
                AutoProperties="true">
    </EntityType>

    <!--产品型号-->
    <EntityType Name="ProductModel" OfbizEntity="GoodIdentification"
                EntityCondition="goodIdentificationTypeId=MANUFACTURER_ID_NO"
                EntitySetName="ProductModels"
                AutoProperties="true">
        <Property Name="idValue" FieldControl="Mandatory" Required="true"/>
    </EntityType>

    <!--=====================================     子对象对象EntityType definition End    =====================================-->

</ofbiz-edm>
