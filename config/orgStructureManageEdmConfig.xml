<ofbiz-edm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://dev.odatalab.com/dtds/edmconfig.xsd" ImportGlobal="false">

    <!--=====================================     主对象EntityType definition     =====================================-->
    <!--主部门-->
    <EntityType Name="Company" OfbizEntity="Party" EntitySetName="Companies"
                AutoProperties="true" EntityCondition="PartyRole/roleTypeId=INTERNAL_ORGANIZATIO">
        <NavigationProperty Name="Department" Type="Department" Relations="FromPartyRelationship/ToPartyAndPartyGroup" IsCollection="true"/>
        <NavigationProperty Name="Member" Type="Member" Relations="FromPartyRelationship/ToPartyAndContact" IsCollection="true"/>
<!--        <NavigationProperty Name="DesignatedMember" Type="Member" Relations="FromPartyRelationship/PartyAndContact"/>-->
    </EntityType>

    <!--部门-->
    <EntityType Name="Department" OfbizEntity="PartyAndPartyGroup" EntitySetName="Departments"
                AutoProperties="true">
        <LineItem Qualifier="Department">
            <DataField Values="partyId,partyName" Importance="High"/>
        </LineItem>
        <NavigationProperty Name="SubDepartment" Type="Department" Relations="FromPartyRelationship/ToPartyAndPartyGroup" IsCollection="true"/>
        <NavigationProperty Name="Member" Type="Member" Relations="FromPartyRelationship/ToPartyAndContact" IsCollection="true"/>
     </EntityType>

    <!--成员-->
    <EntityType Name="Member" OfbizEntity="PartyAndContact" EntitySetName="Members"
                AutoProperties="true">
        <LineItem Qualifier="Member">
            <DataField Values="partyId,partyName" Importance="High"/>
        </LineItem>
    </EntityType>

    <!--=====================================     子对象EntityType definition     =====================================-->
    <!--=====================================    Action Definition End   =====================================-->
</ofbiz-edm>
