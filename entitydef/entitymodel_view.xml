<?xml version="1.0" encoding="UTF-8"?>
<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/entitymodel.xsd">
	<title>Entity of an dpbird Component</title>
	<description>None</description>
	<copyright></copyright>
	<version></version>

    <view-entity entity-name="PartyAndPartyGroup" package-name="com.banfftech.gongsconfig">
        <member-entity entity-alias="PTY" entity-name="Party"/>
        <member-entity entity-alias="PTGP" entity-name="PartyGroup"/>
        <alias-all entity-alias="PTY"/>
        <alias-all entity-alias="PTGP"/>
        <view-link entity-alias="PTY" rel-entity-alias="PTGP" rel-optional="false">
            <key-map field-name="partyId"/>
        </view-link>
        <relation type="many" title="From" rel-entity-name="PartyRelationship">
            <key-map field-name="partyId" rel-field-name="partyIdFrom"/>
        </relation>
        <relation type="many" title="To" rel-entity-name="PartyRelationship">
            <key-map field-name="partyId" rel-field-name="partyIdTo"/>
        </relation>
        <relation type="many" rel-entity-name="PartyRole">
            <key-map field-name="partyId"/>
        </relation>
    </view-entity>


    <view-entity entity-name="Approval" package-name="com.banfftech.gongsconfig">
        <member-entity entity-alias="WEFT" entity-name="WorkEffort"/>
        <member-entity entity-alias="WEETPA" entity-name="WorkEffortPartyAssignment"/>
        <alias-all entity-alias="WEFT"/>
        <alias-all entity-alias="WEETPA"/>
        <view-link entity-alias="WEFT" rel-entity-alias="WEETPA" rel-optional="false">
            <key-map field-name="workEffortId"/>
            <entity-condition>
                <condition-expr entity-alias="WEFT" field-name="workEffortTypeId" value="APPROVAL"/>
            </entity-condition>
        </view-link>
        <relation type="one-nofk" title="Approval" rel-entity-name="StatusItem">
            <key-map field-name="statusId" />
        </relation>
        <relation type="one-nofk" title="Top" rel-entity-name="WorkEffort">
            <key-map field-name="topWorkEffortId" rel-field-name="workEffortId"/>
        </relation>
    </view-entity>

</entitymodel>
