<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <!-- ========================================================= -->
    <!-- ======================== Defaults ======================= -->
    <!-- ========================================================= -->
    <title>Entity of GongsConfig Compone-nofk nt</title>
    <description>None-nofk </description>
    <copyright></copyright>
    <version></version>

    <extend-entity entity-name="PartyRelationship">
        <relation type="one-nofk" title="From" rel-entity-name="PartyAndPartyGroup">
            <key-map field-name="partyIdFrom" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" title="To" rel-entity-name="PartyAndPartyGroup">
            <key-map field-name="partyIdTo" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" title="From" rel-entity-name="PartyAndContact">
            <key-map field-name="partyIdFrom" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" title="To" rel-entity-name="PartyAndContact">
            <key-map field-name="partyIdTo" rel-field-name="partyId"/>
        </relation>
    </extend-entity>

    <extend-entity entity-name="Person">
        <relation type="one" fk-name="PERSON_GENDER_ENUM" title="Gender" rel-entity-name="Enumeration">
            <key-map field-name="gender" rel-field-name="enumId"/>
        </relation>
    </extend-entity>

    <extend-entity entity-name="PartyRole">
        <relation type="one-nofk" rel-entity-name="PartyAndContact">
            <key-map field-name="partyId" rel-field-name="partyId"/>
        </relation>
    </extend-entity>

    <extend-entity entity-name="WorkEffort">
        <field name="topWorkEffortId" type="id"/>
        <relation type="one" fk-name="TOP_WORK_EFFORT" title="Top" rel-entity-name="WorkEffort">
            <key-map field-name="topWorkEffortId" rel-field-name="workEffortId"/>
        </relation>
        <relation type="one" fk-name="WKEFT_USERLOGIN" rel-entity-name="UserLogin">
            <key-map field-name="createdByUserLogin" rel-field-name="userLoginId"/>
        </relation>
        <relation type="many" title="Node" rel-entity-name="WorkEffort">
            <key-map field-name="workEffortId" rel-field-name="topWorkEffortId"/>
        </relation>
        <relation type="many" rel-entity-name="Approval">
            <key-map field-name="workEffortId" rel-field-name="topWorkEffortId"/>
        </relation>
    </extend-entity>


    <extend-entity entity-name="WorkEffortPartyAssignment">
        <field name="mannerEnumId" type="id"/>
        <relation type="one" fk-name="WEPA_ENUM" title="Manner" rel-entity-name="Enumeration">
            <key-map field-name="mannerEnumId" rel-field-name="enumId"/>
        </relation>
    </extend-entity>


</entitymodel>