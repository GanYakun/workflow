<entity-eca xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entity-eca.xsd">

    <!-- 根节点_开始 -->
    <eca entity="WorkEffort" operation="create-store" event="return">
        <condition field-name="workEffortTypeId" operator="equals" value="ROOT_NODE"/>
        <condition field-name="currentStatusId" operator="equals" value="WEPR_WAIT"/>
        <action service="banfftech.checkDecision" mode="sync"/>
    </eca>

    <!-- 审批节点_通过 -->
    <eca entity="WorkEffort" operation="create-store" event="return">
        <condition field-name="workEffortTypeId" operator="equals" value="APPROVAL"/>
        <condition field-name="currentStatusId" operator="equals" value="WEPR_COMPLETE"/>
        <action service="banfftech.checkDecision" mode="sync"/>
    </eca>

    <!-- 审批节点_拒绝 -->
    <eca entity="WorkEffort" operation="create-store" event="return">
        <condition field-name="workEffortTypeId" operator="equals" value="APPROVAL"/>
        <condition field-name="currentStatusId" operator="equals" value="WEPR_REFUSE"/>
        <action service="banfftech.checkDecision" mode="sync"/>
    </eca>

    <!-- 抄送节点_通过 -->
    <eca entity="WorkEffort" operation="create-store" event="return">
        <condition field-name="workEffortTypeId" operator="equals" value="MAKE_COPY"/>
        <condition field-name="currentStatusId" operator="equals" value="WEPR_COMPLETE"/>
        <action service="banfftech.checkDecision" mode="sync"/>
    </eca>

    <!-- 条件节点_通过 -->
    <eca entity="WorkEffort" operation="create-store" event="return">
        <condition field-name="workEffortTypeId" operator="equals" value="CONDITION"/>
        <condition field-name="currentStatusId" operator="equals" value="WEPR_COMPLETE"/>
        <action service="banfftech.checkDecision" mode="sync"/>
    </eca>

    <!-- 审批人审批通过 -->
    <eca entity="WorkEffortPartyAssignment" operation="create-store" event="return">
        <condition field-name="statusId" operator="equals" value="WEPR_COMPLETE"/>
        <condition field-name="mannerEnumId" operator="equals" value="PASS_APPROVE"/>
        <action service="banfftech.checkNode" mode="sync"/>
    </eca>
    <!-- 审批人审批拒绝 -->
    <eca entity="WorkEffortPartyAssignment" operation="create-store" event="return">
        <condition field-name="statusId" operator="equals" value="WEPR_REFUSE"/>
        <condition field-name="mannerEnumId" operator="equals" value="PASS_APPROVE"/>
        <action service="banfftech.checkNode" mode="sync"/>
    </eca>

<!--    <eca entity="WorkEffort" operation="create-store" event="return">-->
<!--        <condition field-name="workEffortTypeId" operator="equals" value="ROUTING"/>-->
<!--        <condition field-name="currentStatusId" operator="equals" value="WEPR_COMPLETE"/>-->
<!--        <action service="banfftech.checkNext" mode="sync"/>-->
<!--    </eca>-->

    <!-- 添加活更改成员部门时触发 -->
    <eca entity="PartyRelationship" operation="create-store" event="return">
        <condition field-name="roleTypeIdTo" operator="equals" value="ORD_EMPLOYEE"/>
        <action service="banfftech.updateMemberNumber" mode="sync"/>
    </eca>

</entity-eca>
