<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <!-- ========================================================= -->
    <!-- ======================== Defaults ======================= -->
    <!-- ========================================================= -->
    <title>Entity of ApprovalFlow Component</title>
    <description>审批流实体</description>
    <copyright></copyright>
    <version></version>

    <entity entity-name="MainProcess" package-name="com.banfftech.approval">
        <description>流程主对象</description>
        <field name="processId" type="id"><description>主键</description></field>
        <field name="processEntityId" type="id"><description>业务对象</description></field>
        <field name="statusId" type="id"><description>状态</description></field>
        <field name="rangeEnumId" type="id"><description>可见范围(enum)</description></field>
        <field name="description" type="value"><description>描述</description></field>
        <field name="workFlowId" type="id"><description>关联流程模板</description></field>
        <field name="createdDate" type="date-time"><description>创建时间</description></field>
        <field name="version" type="value"><description>版本号</description></field>
        <prim-key field="processId"/>
        <relation type="one" fk-name="MA_PROC_ENTITY" rel-entity-name="ProcessEntity">
            <key-map field-name="processEntityId"/>
        </relation>
        <relation type="one" title="Range" fk-name="PC_RANGE_ENUM" rel-entity-name="Enumeration">
            <key-map field-name="rangeEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="PROCESS_WORK_FLOW" rel-entity-name="WorkEffort">
            <key-map field-name="workFlowId" rel-field-name="workEffortId"/>
        </relation>
        <relation type="one" fk-name="PROCESS_STATUS" rel-entity-name="StatusItem">
            <key-map field-name="statusId" rel-field-name="statusId"/>
        </relation>
    </entity>

    <entity entity-name="WorkFlowMember" package-name="com.banfftech.approval">
        <description>审批流程和审批对象关联表</description>
        <field name="workFlowMemberId" type="id"><description>主键</description></field>
        <field name="workEffortId" type="id"><description>审批流根节点id</description></field>
        <field name="memberEntityName" type="id"><description>关联对象</description></field>
        <field name="memberEntityId" type="id"><description>关联对象Id</description></field>
        <prim-key field="workFlowMemberId"/>
        <relation type="one" fk-name="WF_MEM_WORKEFF" rel-entity-name="WorkEffort">
            <key-map field-name="workEffortId"/>
        </relation>
        <relation type="one-nofk" fk-name="WF_MEM_PTY" rel-entity-name="PartyAndContact">
            <key-map field-name="memberEntityId" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" fk-name="WF_MEM_EMPL" rel-entity-name="EmplLeave">
            <key-map field-name="memberEntityId" rel-field-name="emplLeaveId"/>
        </relation>
        <relation type="one-nofk" fk-name="WF_MEM_REQ" rel-entity-name="Requirement">
            <key-map field-name="memberEntityId" rel-field-name="requirementId"/>
        </relation>
    </entity>





</entitymodel>